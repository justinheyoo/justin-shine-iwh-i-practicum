doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Update Custom Object Form
        .form-wrapper
            form(action="/update-cobj" method="POST")
                label(for="name") Name
                input#name(type="text" name="name" required)
                label(for="species") Species
                input#species(type="text" name="species")
                label(for="environment") Environment
                select#environment(name="environment")
                    option(value="Land") Land
                    option(value="Ocean") Ocean
                    option(value="Sky") Sky
                input(type="submit" value="Create Animal")
            a(href="/") Return to the homepage
